<div class="standard-form">
    <div class="standard-form scrollable">
        <nav class="sheet-tabs tabs" style="flex: none;">
            <a class="item active" data-action="tab" data-group="primary" data-tab="coreRolls">
                <span>
                    <i class="fa-solid fa-dice-d20"></i>
                    {{localize "CUSTOM_DND5E.coreRolls"}}
                </span>
            </a>
            <a class="item" data-action="tab" data-group="primary" data-tab="weaponTypes">
                <span>
                    <i class="fa-solid fa-sword"></i>
                    {{localize "CUSTOM_DND5E.weaponTypes"}}
                </span>
            </a>
        </nav>
        <section class="tab active" data-group="primary" data-tab="coreRolls">
            <fieldset>
                <legend>{{localize "CUSTOM_DND5E.abilityCheck"}}</legend>
                {{> "modules/custom-dnd5e/templates/roll-die-fields.hbs" prefix="rolls.ability" roll=rolls.ability selects=selects}}
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.rollMode"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-ability-roll-mode" name="rolls.ability.rollMode">
                            {{selectOptions selects.rollMode.choices selected=rolls.ability.rollMode localize=true}}
                        </select>
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>{{localize "CUSTOM_DND5E.attackRoll"}}</legend>
                {{> "modules/custom-dnd5e/templates/roll-die-fields.hbs" prefix="rolls.attack" roll=rolls.attack selects=selects}}
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.rollMode"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-attack-roll-mode" name="rolls.attack.rollMode">
                            {{selectOptions selects.rollMode.choices selected=rolls.attack.rollMode localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.criticalHitRule"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-attack-critical-rule" name="rolls.attack.criticalRule">
                            {{selectOptions selects.criticalRule.choices selected=rolls.attack.criticalRule localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group" data-critical-lower-bound-group>
                    <label>{{localize "CUSTOM_DND5E.criticalHitLowerBound"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-attack-critical-lower-bound" name="rolls.attack.criticalLowerBound">
                            {{selectOptions selects.criticalLowerBound.choices selected=rolls.attack.criticalLowerBound}}
                        </select>
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>{{localize "CUSTOM_DND5E.concentrationSavingThrow"}}</legend>
                {{> "modules/custom-dnd5e/templates/roll-die-fields.hbs" prefix="rolls.concentration" roll=rolls.concentration selects=selects}}
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.rollMode"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-concentration-roll-mode" name="rolls.concentration.rollMode">
                            {{selectOptions selects.rollMode.choices selected=rolls.concentration.rollMode localize=true}}
                        </select>
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>{{localize "CUSTOM_DND5E.initiativeRoll"}}</legend>
                {{> "modules/custom-dnd5e/templates/roll-die-fields.hbs" prefix="rolls.initiative" roll=rolls.initiative selects=selects}}
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.rollMode"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-initiative-roll-mode" name="rolls.initiative.rollMode">
                            {{selectOptions selects.rollMode.choices selected=rolls.initiative.rollMode localize=true}}
                        </select> 
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>{{localize "CUSTOM_DND5E.savingThrow"}}</legend>
                {{> "modules/custom-dnd5e/templates/roll-die-fields.hbs" prefix="rolls.savingThrow" roll=rolls.savingThrow selects=selects}}
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.rollMode"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-saving-throw-roll-mode" name="rolls.savingThrow.rollMode">
                            {{selectOptions selects.rollMode.choices selected=rolls.savingThrow.rollMode localize=true}}
                        </select> 
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>{{localize "CUSTOM_DND5E.skillCheck"}}</legend>
                {{> "modules/custom-dnd5e/templates/roll-die-fields.hbs" prefix="rolls.skill" roll=rolls.skill selects=selects}}
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.rollMode"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-skill-roll-mode" name="rolls.skill.rollMode">
                            {{selectOptions selects.rollMode.choices selected=rolls.skill.rollMode localize=true}}
                        </select>
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>{{localize "CUSTOM_DND5E.toolCheck"}}</legend>
                {{> "modules/custom-dnd5e/templates/roll-die-fields.hbs" prefix="rolls.tool" roll=rolls.tool selects=selects}}
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.rollMode"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-rolls-tool-roll-mode" name="rolls.tool.rollMode">
                            {{selectOptions selects.rollMode.choices selected=rolls.tool.rollMode localize=true}}
                        </select>
                    </div>
                </div>
            </fieldset>
        </section>
        <section class="tab" data-group="primary" data-tab="weaponTypes">
            <div class="form-group">
                <label>{{localize "CUSTOM_DND5E.rolls.weaponOverrides.enable"}}</label>
                <div class="form-fields">
                    <input type="checkbox" name="rolls.weaponTypeOverridesEnabled" {{checked rolls.weaponTypeOverridesEnabled}}>
                </div>
                <p class="hint">{{localize "CUSTOM_DND5E.rolls.weaponOverrides.hint"}}</p>
            </div>
            <div data-weapon-overrides class="{{#unless rolls.weaponTypeOverridesEnabled}}hidden{{/unless}}">
            {{#each rolls.weaponTypes as |weaponType key|}}
            <fieldset>
                <legend>{{label}}</legend>
                {{> "modules/custom-dnd5e/templates/roll-die-fields.hbs" prefix="rolls.weaponTypes" key=key roll=weaponType selects=../selects}}
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.rollMode"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-roll-mode" name="rolls.weaponTypes.{{key}}.rollMode">
                            {{selectOptions ../selects.rollMode.choices selected=rollMode localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "CUSTOM_DND5E.criticalHitRule"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-critical-rule" name="rolls.weaponTypes.{{key}}.criticalRule">
                            {{selectOptions ../selects.criticalRule.choices selected=criticalRule localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group" data-critical-lower-bound-group>
                    <label>{{localize "CUSTOM_DND5E.criticalHitLowerBound"}}</label>
                    <div class="form-fields">
                        <select id="custom-dnd5e-critical-lower-bound" name="rolls.weaponTypes.{{key}}.criticalLowerBound">
                            {{selectOptions ../selects.criticalLowerBound.choices selected=criticalLowerBound}}
                        </select>
                    </div>
                </div>
            </fieldset>
            {{/each}}
            </div>
        </section>  
    </div>
    <footer class="form-footer" data-application-part="footer">
        <button type="submit" class="save-button">
            <i class="fas fa-solid fa-floppy-disk"></i>{{localize "CUSTOM_DND5E.form.button.save.label"}}
        </button>
    </footer>
</div>
